# Herdadas do export original do Google AI Studio. Nenhuma tela do site as usa.
# ATENÇÃO: o vite.config.ts injeta GEMINI_API_KEY no bundle do NAVEGADOR via `define`,
# ou seja, se ela for preenchida a chave fica pública. Deixar vazia.
GEMINI_API_KEY=
APP_URL=

# ---------------------------------------------------------------------------
# Medição e formulário. As duas são embutidas no bundle no momento do BUILD —
# mudar o valor exige rebuildar o site, não basta reiniciar o container.
# Nenhuma das duas é segredo: as duas ficam visíveis no HTML/JS publicado.
# ---------------------------------------------------------------------------

# Id de medição do GA4 ("G-XXXXXXXXXX"), de analytics.google.com.
# Sem ele o site NÃO mede nada e a página /analise do CRM fica vazia.
VITE_GA4_MEASUREMENT_ID=

# URL do webhook do n8n que recebe o formulário de contato.
# O n8n acrescenta o FORM_LEADS_SECRET e repassa para
# https://integrallys-crm.vercel.app/api/leads/form — o segredo NÃO pode vir
# para cá, porque tudo daqui vai junto no bundle público.
# Sem ela, o formulário mostra o erro e oferece o WhatsApp.
VITE_LEAD_WEBHOOK_URL=
